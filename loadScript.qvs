///$tab Main
SECTION ACCESS;
Load * INLINE [
    ACCESS, USERID, VISION_SA, JURIDICTION
    USER, AGILOS\MLA, STANDARD, COUR
    USER, AGILOS\MLA, ETENDUE, TRIBUNAL
    USER, AGILOS\VHO, ETENDUE, COUR
    ADMIN, INTERNAL\SA_SCHEDULER,  *     
];


SECTION Application;

SET ThousandSep=',';
SET DecimalSep='.';
SET MoneyThousandSep=',';
SET MoneyDecimalSep='.';
SET MoneyFormat='$#,##0.00;-$#,##0.00';
SET TimeFormat='h:mm:ss TT';
SET DateFormat='M/D/YYYY';
SET TimestampFormat='M/D/YYYY h:mm:ss[.fff] TT';
SET FirstWeekDay=6;
SET BrokenWeeks=1;
SET ReferenceDay=0;
SET FirstMonthOfYear=1;
SET CollationLocale='en-US';
SET CreateSearchIndexOnReload=1;
SET MonthNames='Jan;Feb;Mar;Apr;May;Jun;Jul;Aug;Sep;Oct;Nov;Dec';
SET LongMonthNames='January;February;March;April;May;June;July;August;September;October;November;December';
SET DayNames='Mon;Tue;Wed;Thu;Fri;Sat;Sun';
SET LongDayNames='Monday;Tuesday;Wednesday;Thursday;Friday;Saturday;Sunday';
SET NumericalAbbreviation='3:k;6:M;9:G;12:T;15:P;18:E;21:Z;24:Y;-3:m;-6:μ;-9:n;-12:p;-15:f;-18:a;-21:z;-24:y';



LOAD 
	*,
	IF(len(trim(DATE_CLOTURE))=0, 1, 0) AS IS_PENDANTE;
LOAD
    NUMERO_AFFAIRE,
    DATE_REFERENCE,
    DATE_INTRODUCTION,
    DATE_CLOTURE,
    UPPER(JURIDICTION) AS JURIDICTION,
    ADMIN_GREFFE_LIB,
    GREFFE_LIB,
    JUGE_RAPPORTEUR_LIB,
    AVOCAT_GENERAL_LIB,
    FORMATION,
    ARCHETYPE_PROCEDURAL_CODE,
    ARCHETYPE_PROCEDURAL_LIB,
    TYPE_RECOURS_CODE,
    TYPE_RECOURS_LIB,
    MATIERE_PRINCIPALE,
    LP,
    PHASE_PROCEDURALE,
    ETAT_AFFAIRE_CODE,
    ETAT_AFFAIRE_LIB,
    NOM_USUEL,
    AFFAIRES_INTRODUITES,
    AFFAIRES_CLOTUREES,
    AFFAIRES_PENDANTES,
    TYPE_CHAMBRE_LIB
FROM [lib://AttachedFiles/dataset_prototype_reporting_cour_tribunal.xlsx]
(ooxml, embedded labels, table is Affaires);

test:
LOAD * INLINE [
Vision, VISION_SA
Standard, STANDARD
Etendue, ETENDUE
];

